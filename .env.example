# Copy to .env and replace every placeholder. Never commit .env.
# With every value empty, classrooms are kept in each browser (IndexedDB) and nobody signs in.

# Google Sheet backend (apps-script/README.md), used when all three are set. Teachers sign in with Google to write
# the sheet; every read (the teacher's and the student link's) goes through the read-only Apps Script web app.
# None of these is secret, but anyone with the script URL can read the whole sheet.
VITE_GOOGLE_CLIENT_ID=
VITE_SHEET_ID=
VITE_SHEET_API_URL=
