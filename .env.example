# Copy to .env and replace every placeholder. Never commit .env.
# The API, PostgreSQL and docker compose settings are configured with the API, not here.

# Frontend (Vite). Empty means same origin (the Vite dev proxy or the nginx container).
VITE_API_BASE_URL=
# Google Sheet backend (apps-script/README.md). When both are set, teachers sign in with Google and the browser
# reads and writes the sheet itself; neither value is secret, the sheet's sharing settings protect it.
VITE_GOOGLE_CLIENT_ID=
VITE_SHEET_ID=
# The read-only Apps Script web app URL that serves the student classroom link in Google Sheet mode.
VITE_SHEET_API_URL=
# Where the Vite dev server proxies /api (match the API's port).
VITE_PROXY_TARGET=http://localhost:8080
